-# Path to copy of OS ISO image (xCAT recipe only)
-iso_path="${iso_path:-}"
-
-# Osdeployment Initialize Options (Confluent recipe only)
-initialize_options="${initialize_options:-usklpta}"
-deployment_protocols="${deployment_protocols:-firmware}"
-
-
-
