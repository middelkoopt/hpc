-            'ci_run' => \$ci_run);
-
-if ( $#ARGV < 0 ) {
-print "$repo $ci_run\n";
-    print STDERR "Usage: parse_doc [--repo=<reponame>] [--ci_run] <filename>\n";
-    print STDERR "  --repo     Use a different repo for install commands\n";
-    print STDERR "  --ci_run   run additional 'CI only' commands\n";
-    exit 1;
-}
