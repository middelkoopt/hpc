-    $cmd =~ s/\(\*\\beegfsrepo\*\)/$beegfsrepo/;
-    $cmd =~ s/\(\*\\cudarepo\*\)/$cudarepo/;
-    $cmd =~ s/BOSVER/$BaseOS/;
-    $cmd =~ s/OSIMAGE/$OSimage/;
-    $cmd =~ s/BOSSHORT/$BaseOSshort/;
-    $cmd =~ s/ARCH/$arch/g;
-    $cmd =~ s/VERLONG/$verlong/g;
-    $cmd =~ s/OSTREE/$OSTree/;
