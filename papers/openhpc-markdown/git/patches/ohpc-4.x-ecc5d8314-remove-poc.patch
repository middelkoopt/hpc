-upgrade: "dnf -y upgrade"
-chrootupgrade: "dnf -y --installroot=\"$CHROOT\" upgrade"
-tftppkg: "syslinux-tftpboot"
-
-# Repository URLs
-beegfsrepo: "https://www.beegfs.io/release/beegfs_7.4.5/dists/beegfs-rhel9.repo"
-
-# Boolean toggles for conditional content
-isCentOS: true
