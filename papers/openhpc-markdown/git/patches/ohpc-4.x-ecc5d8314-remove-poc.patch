-SLURM: "Slurm"
-infiniband: "InfiniBand"
-OmniPath: "Omni-Path"
-beegfs: "BeeGFS"
-clustershell: "ClusterShell"
-conman: "ConMan"
-genders: "genders"
-nhc: "NHC"
-lustre: "Lustre"
-os_name: "AlmaLinux 10"
-intelr: "Intel®"
-enable_ib: false
-enable_opa: false
-enable_clustershell: false
-enable_genders: false
-enable_magpie: false
-enable_ipmisol: false
-add_ofed: false
-enable_ipoib: false
